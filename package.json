    "@tanstack/react-virtual": "^3.13.23",
    "bippy": "^0.5.32",
    "dexie": "^4.4.1",
    "error-stack-parser": "^2.1.4",
    "lucide-react": "^1.7.0",
    "overlayscrollbars": "^2.14.0",
    "overlayscrollbars-react": "^0.5.6",
    "source-map-js": "^1.2.1",
    "zustand": "^5.0.12"
